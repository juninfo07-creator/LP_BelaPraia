# Copie para .env (uso local) e nunca commite o arquivo .env de verdade.
# No Vercel, configure essas variáveis em Project Settings > Environment Variables.

# Token de acesso da API de Conversões do Meta (Events Manager > Configurações > API de Conversões)
META_CAPI_TOKEN=

# ID do Pixel (o mesmo já usado no index.html). Opcional: só precisa se quiser trocar sem editar o código.
META_PIXEL_ID=972767522539205
